<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SharedLibraryVersion Condition="'$(SharedLibraryVersion)' == ''">1.0.*-*</SharedLibraryVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <ProjectReference Include="..\..\Maliev.Aspire\Maliev.Aspire.ServiceDefaults\Maliev.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Maliev.MessagingContracts\generated\csharp\Maliev.MessagingContracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Maliev.Aspire.ServiceDefaults" Version="$(SharedLibraryVersion)" />
    <PackageReference Include="Maliev.MessagingContracts" Version="$(SharedLibraryVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maliev.QuotationService.Application\Maliev.QuotationService.Application.csproj" />
    <ProjectReference Include="..\Maliev.QuotationService.Infrastructure\Maliev.QuotationService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DTOs\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="ExternalClients\**\*.cs" />
    <Compile Remove="Consumers\**\*.cs" />
    <Compile Remove="Middleware\**\*.cs" />
  </ItemGroup>

</Project>
