<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maliev.QuotationService.Application\Maliev.QuotationService.Application.csproj" />
    <ProjectReference Include="..\Maliev.QuotationService.Domain\Maliev.QuotationService.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <ProjectReference Include="..\..\Maliev.Aspire\Maliev.Aspire.ServiceDefaults\Maliev.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Maliev.MessagingContracts\generated\csharp\Maliev.MessagingContracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Maliev.Aspire.ServiceDefaults" Version="$(SharedLibraryVersion)" />
    <PackageReference Include="Maliev.MessagingContracts" Version="$(SharedLibraryVersion)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Maliev.QuotationService.Data\QuotationDbContext.cs" />
    <Compile Include="..\Maliev.QuotationService.Data\QuotationDbContextFactory.cs" />
    <Compile Include="..\Maliev.QuotationService.Data\Configurations\**\*.cs" />
    <Compile Include="..\Maliev.QuotationService.Data\Migrations\**\*.cs" />
    <Compile Include="..\Maliev.QuotationService.Api\Services\**\*.cs"
             Exclude="..\Maliev.QuotationService.Api\Services\Interfaces\**\*.cs" />
    <Compile Include="..\Maliev.QuotationService.Api\ExternalClients\**\*.cs" />
    <Compile Include="..\Maliev.QuotationService.Api\Consumers\**\*.cs" />
    <Compile Include="..\Maliev.QuotationService.Api\Middleware\**\*.cs" />
  </ItemGroup>

</Project>
